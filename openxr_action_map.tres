[gd_resource type="OpenXRActionMap" format=3]

[sub_resource type="OpenXRAction" id="OpenXRAction_trigger"]
resource_name = "trigger"
localized_name = "Trigger / pinch"
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_grip"]
resource_name = "grip"
localized_name = "Grip / grasp"
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_primary"]
resource_name = "primary"
localized_name = "Primary thumbstick"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_primary_click"]
resource_name = "primary_click"
localized_name = "Primary thumbstick click"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_menu"]
resource_name = "menu_button"
localized_name = "Menu"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_ax"]
resource_name = "ax_button"
localized_name = "A/X"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_by"]
resource_name = "by_button"
localized_name = "B/Y"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_default_pose"]
resource_name = "default_pose"
localized_name = "Default pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_aim_pose"]
resource_name = "aim_pose"
localized_name = "Aim pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_haptic"]
resource_name = "haptic"
localized_name = "Haptic"
action_type = 4
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="OpenXRActionSet_godot"]
resource_name = "godot"
localized_name = "Godot action set"
actions = [SubResource("OpenXRAction_trigger"), SubResource("OpenXRAction_grip"), SubResource("OpenXRAction_primary"), SubResource("OpenXRAction_primary_click"), SubResource("OpenXRAction_menu"), SubResource("OpenXRAction_ax"), SubResource("OpenXRAction_by"), SubResource("OpenXRAction_default_pose"), SubResource("OpenXRAction_aim_pose"), SubResource("OpenXRAction_haptic")]

[sub_resource type="OpenXRIPBinding" id="Oculus_default_left"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Oculus_default_right"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Oculus_aim_left"]
action = SubResource("OpenXRAction_aim_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Oculus_aim_right"]
action = SubResource("OpenXRAction_aim_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Oculus_menu_left"]
action = SubResource("OpenXRAction_menu")
binding_path = "/user/hand/left/input/menu/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_ax_left"]
action = SubResource("OpenXRAction_ax")
binding_path = "/user/hand/left/input/x/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_ax_right"]
action = SubResource("OpenXRAction_ax")
binding_path = "/user/hand/right/input/a/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_by_left"]
action = SubResource("OpenXRAction_by")
binding_path = "/user/hand/left/input/y/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_by_right"]
action = SubResource("OpenXRAction_by")
binding_path = "/user/hand/right/input/b/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_trigger_left"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="Oculus_trigger_right"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="Oculus_grip_left"]
action = SubResource("OpenXRAction_grip")
binding_path = "/user/hand/left/input/squeeze/value"

[sub_resource type="OpenXRIPBinding" id="Oculus_grip_right"]
action = SubResource("OpenXRAction_grip")
binding_path = "/user/hand/right/input/squeeze/value"

[sub_resource type="OpenXRIPBinding" id="Oculus_primary_left"]
action = SubResource("OpenXRAction_primary")
binding_path = "/user/hand/left/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="Oculus_primary_right"]
action = SubResource("OpenXRAction_primary")
binding_path = "/user/hand/right/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="Oculus_primary_click_left"]
action = SubResource("OpenXRAction_primary_click")
binding_path = "/user/hand/left/input/thumbstick/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_primary_click_right"]
action = SubResource("OpenXRAction_primary_click")
binding_path = "/user/hand/right/input/thumbstick/click"

[sub_resource type="OpenXRIPBinding" id="Oculus_haptic_left"]
action = SubResource("OpenXRAction_haptic")
binding_path = "/user/hand/left/output/haptic"

[sub_resource type="OpenXRIPBinding" id="Oculus_haptic_right"]
action = SubResource("OpenXRAction_haptic")
binding_path = "/user/hand/right/output/haptic"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRProfile_oculus"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("Oculus_default_left"), SubResource("Oculus_default_right"), SubResource("Oculus_aim_left"), SubResource("Oculus_aim_right"), SubResource("Oculus_menu_left"), SubResource("Oculus_ax_left"), SubResource("Oculus_ax_right"), SubResource("Oculus_by_left"), SubResource("Oculus_by_right"), SubResource("Oculus_trigger_left"), SubResource("Oculus_trigger_right"), SubResource("Oculus_grip_left"), SubResource("Oculus_grip_right"), SubResource("Oculus_primary_left"), SubResource("Oculus_primary_right"), SubResource("Oculus_primary_click_left"), SubResource("Oculus_primary_click_right"), SubResource("Oculus_haptic_left"), SubResource("Oculus_haptic_right")]

[sub_resource type="OpenXRIPBinding" id="Hand_default_left"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Hand_default_right"]
action = SubResource("OpenXRAction_default_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Hand_aim_left"]
action = SubResource("OpenXRAction_aim_pose")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Hand_aim_right"]
action = SubResource("OpenXRAction_aim_pose")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="Hand_pinch_left"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/left/input/pinch_ext/value"

[sub_resource type="OpenXRIPBinding" id="Hand_pinch_right"]
action = SubResource("OpenXRAction_trigger")
binding_path = "/user/hand/right/input/pinch_ext/value"

[sub_resource type="OpenXRIPBinding" id="Hand_grasp_left"]
action = SubResource("OpenXRAction_grip")
binding_path = "/user/hand/left/input/grasp_ext/value"

[sub_resource type="OpenXRIPBinding" id="Hand_grasp_right"]
action = SubResource("OpenXRAction_grip")
binding_path = "/user/hand/right/input/grasp_ext/value"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRProfile_hands"]
interaction_profile_path = "/interaction_profiles/ext/hand_interaction_ext"
bindings = [SubResource("Hand_default_left"), SubResource("Hand_default_right"), SubResource("Hand_aim_left"), SubResource("Hand_aim_right"), SubResource("Hand_pinch_left"), SubResource("Hand_pinch_right"), SubResource("Hand_grasp_left"), SubResource("Hand_grasp_right")]

[resource]
action_sets = [SubResource("OpenXRActionSet_godot")]
interaction_profiles = [SubResource("OpenXRProfile_oculus"), SubResource("OpenXRProfile_hands")]
